{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "/automation/engine/**"
    ]
  },
  "deploy": {
    "startCommand": "sh -c 'uvicorn engine.dashboard:app --host 0.0.0.0 --port ${PORT:-8080}'",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
