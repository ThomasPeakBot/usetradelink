{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "/automation/engine/**"
    ]
  },
  "deploy": {
    "startCommand": "python -m engine.run",
    "cronSchedule": "30 14 * * *",
    "restartPolicyType": "NEVER",
    "preDeployCommand": [
      "python -m engine.run migrate"
    ]
  }
}
